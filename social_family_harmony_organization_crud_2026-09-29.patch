+{% extends 'base.html' %}
+{% block title %}Family Harmony | Social Welfare{% endblock %}
+{% block content %}
+<section class="page-head inline">
+  <div>
+    <p class="eyebrow">MATCHMAKING WORKSPACE</p>
+    <h1>Family Harmony profiles</h1>
+  </div>
+  <div class="actions">
+    <a class="primary" href="{% url 'harmony_create' %}">Add profile</a>
+    <a class="secondary export-link" data-export-format="xlsx" href="?q={{ query }}&status={{ status }}&gender={{ gender }}&city={{ city }}&profession={{ profession }}&portfolio={{ portfolio }}&local_council={{ local_council }}&jamatkhana={{ jamatkhana }}&format=xlsx">Excel</a>
+    <a class="secondary export-link" data-export-format="pdf" href="?q={{ query }}&status={{ status }}&gender={{ gender }}&city={{ city }}&profession={{ profession }}&portfolio={{ portfolio }}&local_council={{ local_council }}&jamatkhana={{ jamatkhana }}&format=pdf">PDF</a>
+    <a class="secondary export-link" data-export-format="jpg" href="?q={{ query }}&status={{ status }}&gender={{ gender }}&city={{ city }}&profession={{ profession }}&portfolio={{ portfolio }}&local_council={{ local_council }}&jamatkhana={{ jamatkhana }}&format=jpg">JPG</a>
+  </div>
+</section>
+
+<section class="panel">
+  <form class="filter-bar ajax-filter-form" method="get">
+    <input type="search" name="q" value="{{ query }}" placeholder="Name, phone, or city">
+    <select name="status">
+      <option value="">All statuses</option>
+      {% for value,label in statuses %}
+        <option value="{{ value }}" {% if status == value %}selected{% endif %}>{{ label }}</option>
+      {% endfor %}
+    </select>
+    <select name="gender">
+      <option value="">All genders</option>
+      <option value="Female" {% if gender == 'Female' %}selected{% endif %}>Female</option>
+      <option value="Male" {% if gender == 'Male' %}selected{% endif %}>Male</option>
+    </select>
+    <input name="city" value="{{ city }}" placeholder="City">
+    <input name="profession" value="{{ profession }}" placeholder="Profession">
+    <select name="portfolio">
+      <option value="">All portfolios</option>
+      {% for option in portfolio_options %}<option value="{{ option }}" {% if portfolio == option %}selected{% endif %}>{{ option }}</option>{% endfor %}
+    </select>
+    <select name="local_council" class="select2-filter" data-searchable="true" aria-label="Filter by current local council">
+      <option value="">All local councils</option>
+      {% for local in local_councils %}<option value="{{ local.id }}" {% if local_council == local.id|stringformat:'s' %}selected{% endif %}>{{ local.name }}</option>{% endfor %}
+    </select>
+    <select name="jamatkhana" class="select2-filter" data-searchable="true" aria-label="Filter by current Jamatkhana">
+      <option value="">All Jamatkhanas</option>
+      {% for jk in jamatkhanas %}<option value="{{ jk.id }}" {% if jamatkhana == jk.id|stringformat:'s' %}selected{% endif %}>{{ jk.name }}{% if jk.local_council %} · {{ jk.local_council.name }}{% endif %}</option>{% endfor %}
+    </select>
+    <button class="primary">Filter</button>
+  </form>
+</section>
+
+<div class="list-results">
+<section class="panel table-wrap">
+  <table>
+    <thead>
+      <tr>
+        <th>S.N</th>
+        <th>Photo</th>
+        <th>Serial</th>
+        <th>Portfolio</th>
+        <th>Name</th>
+        <th>Age</th>
+        <th>Gender</th>
+        <th>City</th>
+        <th>Phone</th>
+        <th>Current LC</th>
+        <th>Current JK</th>
+        <th>Profession</th>
+        <th>Status</th>
+        <th>Actions</th>
+      </tr>
+    </thead>
+    <tbody>
+      {% for profile in profiles %}
+      <tr>
+        <td>{{ forloop.counter }}</td>
+        <td>{% if profile.person.photo %}<img class="table-avatar" src="{{ profile.person.photo.url }}" alt="Avatar">{% else %}<span class="table-avatar initials">{{ profile.person.first_name|first }}</span>{% endif %}</td>
+        <td>{{ profile.serial_number }}</td>
+        <td>{{ profile.portfolio|default:'Family Harmony' }}</td>
+        <td><a href="{% url 'harmony_detail' profile.id %}"><strong>{{ profile.person.full_name }}</strong></a><small>{{ profile.person.email|default:'No email' }}</small></td>
+        <td>{{ profile.person.age|default:'—' }}</td>
+        <td>{{ profile.person.gender|default:'—' }}</td>
+        <td><input class="inline-edit" data-inline-url="{% url 'harmony_inline_update' %}" data-record-id="{{ profile.id }}" data-inline-field="city" value="{{ profile.person.city }}" aria-label="City for {{ profile.person.full_name }}"></td>
+        <td>{{ profile.person.mobile|default:'—' }}</td>
+        <td>{{ profile.owning_local_council|default:'—' }}</td>
+        <td>{{ profile.owning_jamatkhana|default:'—' }}</td>
+        <td><input class="inline-edit" data-inline-url="{% url 'harmony_inline_update' %}" data-record-id="{{ profile.id }}" data-inline-field="profession" value="{{ profile.profession }}" aria-label="Profession for {{ profile.person.full_name }}"></td>
+        <td><select class="inline-edit" data-inline-url="{% url 'harmony_inline_update' %}" data-record-id="{{ profile.id }}" data-inline-field="status" aria-label="Status for {{ profile.person.full_name }}">{% for value,label in statuses %}<option value="{{ value }}" {% if profile.status == value %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></td>
+        <td class="row-actions">
+          <a class="action-button view" href="{% url 'harmony_detail' profile.id %}" title="View profile"><span aria-hidden="true">◉</span> View</a>
+          <a class="action-button edit" href="{% url 'harmony_edit' profile.id %}" title="Edit profile"><span aria-hidden="true">✎</span> Edit</a>
+          <a class="action-button whatsapp" href="{% url 'create_profile_share' profile.id %}?redirect=whatsapp" target="_blank" rel="noopener" title="Share on WhatsApp"><span aria-hidden="true">☏</span> WhatsApp</a>
+        </td>
+      </tr>
+      {% empty %}
+      <tr><td colspan="14" class="muted">No family harmony profiles found.</td></tr>
+      {% endfor %}
+    </tbody>
+  </table>
+</section>
+{% include 'partials/pagination.html' %}
+</div>
+{% endblock %}
