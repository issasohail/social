+        draw.text((photo_box[0] + (206 - (box[2] - box[0])) / 2, photo_box[1] + 68), initials, font=initials_font, fill=TEAL)
+    draw.rounded_rectangle(photo_box, radius=12, outline=(190, 212, 222), width=3)
