 <script>(function(){function csrf(){return document.cookie.split('; ').find(x=>x.startsWith('csrftoken='))?.split('=')[1]||''}document.querySelectorAll('.reference-tabs button').forEach(b=>b.onclick=()=>{document.querySelectorAll('.reference-tabs button').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.querySelectorAll('.reference-pane').forEach(p=>p.hidden=p.dataset.category!==b.dataset.tab)});document.querySelectorAll('.reference-pane').forEach(pane=>{let url='/settings/list/'+pane.dataset.category+'/',state=pane.querySelector('.setting-save-state');async function send(action,index,value){let fd=new FormData();fd.append('action',action);if(index!==null)fd.append('index',index);if(value!==null)fd.append('value',value);state.textContent='Saving…';let r=await fetch(url,{method:'POST',headers:{'X-CSRFToken':csrf()},body:fd});let j=await r.json();if(!r.ok||!j.ok){state.textContent=j.error||'Save failed';return false}state.textContent='Saved';setTimeout(()=>state.textContent='',900);return true}function edit(cell){if(cell.querySelector('input'))return;let old=cell.dataset.value,input=document.createElement('input');input.className='reference-editor';input.value=old;cell.textContent='';cell.appendChild(input);input.focus();async function save(){let v=input.value.trim();if(v&&v!==old){if(!await send('update',cell.dataset.index,v)){cell.textContent=old;return}cell.dataset.value=v;cell.textContent=v}else cell.textContent=old}input.addEventListener('blur',save,{once:true});input.onkeydown=e=>{if(e.key==='Enter')input.blur();if(e.key==='Escape')cell.textContent=old}}pane.querySelectorAll('.reference-value').forEach(c=>c.ondblclick=()=>edit(c));pane.querySelectorAll('.setting-edit').forEach(b=>b.onclick=()=>edit(pane.querySelector('.reference-value[data-index="'+b.dataset.index+'"]')));pane.querySelectorAll('.setting-delete').forEach(b=>b.onclick=async()=>{if(confirm('Delete this option?')&&await send('delete',b.dataset.index,''))location.reload()});pane.querySelector('.show-add').onclick=()=>pane.querySelector('.add-row').hidden=false;pane.querySelector('.setting-add-btn').onclick=async()=>{let i=pane.querySelector('.setting-new');if(i.value.trim()&&await send('add',null,i.value.trim()))location.reload()}})})();</script>{% endblock %}
