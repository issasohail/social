+{% extends 'base.html' %}{% block title %}Teams & Contacts{% endblock %}
+{% block content %}
+<div class="page-wrap team-page"><div class="page-heading"><div><span class="eyebrow">DIRECTORY</span><h1>Teams & Contacts</h1><p>Term-based board appointments at national, regional, local council and Jamatkhana level.</p></div><div class="toolbar">{% if request.user.is_superuser %}<a class="btn secondary" href="{% url 'team_settings' %}">⚙ Team settings</a>{% endif %}<a class="btn primary" href="{% url 'team_create' %}">+ Appointment</a></div></div>
+<form class="filter-card" method="get"><div class="team-filters">
+<input name="q" value="{{ filters.q }}" placeholder="Search name, phone, email, position...">
+<select name="term"><option value="">All terms</option>{% for x in terms %}<option value="{{ x.id }}" {% if filters.term == x.id|stringformat:'s' %}selected{% endif %}>{{ x.name }}{% if x.is_current %} • Current{% endif %}</option>{% endfor %}</select>
+<select name="board"><option value="">All boards</option>{% for x in boards %}<option value="{{ x.id }}" {% if filters.board == x.id|stringformat:'s' %}selected{% endif %}>{{ x.name }}</option>{% endfor %}</select>
+<select name="level"><option value="">All levels</option>{% for v,l in levels %}<option value="{{ v }}" {% if filters.level == v %}selected{% endif %}>{{ l }}</option>{% endfor %}</select>
+<select name="portfolio"><option value="">All portfolios</option>{% for x in portfolios %}<option value="{{ x.id }}" {% if filters.portfolio == x.id|stringformat:'s' %}selected{% endif %}>{{ x.name }}</option>{% endfor %}</select>
+<select name="position"><option value="">All positions</option>{% for x in positions %}<option value="{{ x.id }}" {% if filters.position == x.id|stringformat:'s' %}selected{% endif %}>{{ x.name }}</option>{% endfor %}</select>
+<select name="regional"><option value="">All regional councils</option>{% for x in regions %}<option value="{{ x.id }}" {% if filters.regional == x.id|stringformat:'s' %}selected{% endif %}>{{ x.name }}</option>{% endfor %}</select>
+<select name="local"><option value="">All local councils</option>{% for x in locals %}<option value="{{ x.id }}" {% if filters.local == x.id|stringformat:'s' %}selected{% endif %}>{{ x.name }}</option>{% endfor %}</select>
+<select name="jk"><option value="">All jamatkhanas</option>{% for x in jks %}<option value="{{ x.id }}" {% if filters.jk == x.id|stringformat:'s' %}selected{% endif %}>{{ x }}</option>{% endfor %}</select>
+<select name="status"><option value="active" {% if filters.status == 'active' %}selected{% endif %}>Active</option><option value="all" {% if filters.status == 'all' %}selected{% endif %}>All status</option><option value="inactive" {% if filters.status == 'inactive' %}selected{% endif %}>Inactive</option></select><button class="btn primary">Filter</button></div></form>
+<div class="card"><div class="card-head"><h2>Team appointments ({{ appointments|length }})</h2><div class="toolbar"><a class="btn small" href="{% url 'team_export' 'jpg' %}?{{ request.GET.urlencode }}">JPG</a><a class="btn small" href="{% url 'team_export' 'pdf' %}?{{ request.GET.urlencode }}">PDF</a><a class="btn small" href="{% url 'team_export' 'xlsx' %}?{{ request.GET.urlencode }}">Excel</a></div></div><div class="table-scroll"><table class="data-table"><thead><tr><th>#</th><th>Photo</th><th>Name</th><th>Term</th><th>Board</th><th>Position</th><th>Portfolio</th><th>Level / Jurisdiction</th><th>Coverage</th><th>Phone</th><th>Status</th><th>Actions</th></tr></thead><tbody>
+{% for a in appointments %}<tr><td>{{ forloop.counter }}</td><td>{% if a.person.photo %}<img class="team-avatar" src="{{ a.person.photo.url }}">{% else %}<span class="avatar-fallback">{{ a.person.first_name|slice:':1' }}{{ a.person.last_name|slice:':1' }}</span>{% endif %}</td><td><b>{{ a.person.full_name }}</b><small>{{ a.person.email }}</small></td><td>{{ a.term.name }}</td><td>{{ a.board.short_name|default:a.board.name }}</td><td>{{ a.position }}</td><td>{{ a.portfolio|default:'—' }}</td><td>{{ a.get_level_display }}<small>{{ a.jurisdiction_name }}</small></td><td>{% for jk in a.covered_jamatkhanas.all %}<span class="mini-badge">{{ jk }}</span>{% empty %}—{% endfor %}</td><td>{{ a.person.mobile|default:a.person.whatsapp_number|default:'—' }}</td><td><span class="status-pill">{% if a.is_active %}Active{% else %}Inactive{% endif %}</span></td><td><div class="row-actions">{% if a.person.whatsapp_number or a.person.mobile %}<a title="WhatsApp message" target="_blank" href="https://wa.me/{{ a.person.whatsapp_number|default:a.person.mobile|cut:'+' }}">WA</a>{% endif %}<a href="{% url 'team_detail' a.id %}" title="View">👁</a><a href="{% url 'team_edit' a.id %}" title="Edit">✎</a></div></td></tr>{% empty %}<tr><td colspan="12" class="empty">No team appointments match these filters.</td></tr>{% endfor %}</tbody></table></div></div></div>
+{% endblock %}
diff --git a/templates/teams/settings.html b/templates/teams/settings.html
