+{% extends 'base.html' %}{% block title %}{{ appointment.person.full_name }} | Team{% endblock %}{% block content %}<div class="page-wrap team-page"><div class="profile-hero"><div class="profile-photo">{% if appointment.person.photo %}<img src="{{ appointment.person.photo.url }}">{% else %}<span>{{ appointment.person.first_name|slice:':1' }}{{ appointment.person.last_name|slice:':1' }}</span>{% endif %}</div><div class="profile-main"><span class="eyebrow">{{ appointment.term.name }} · {{ appointment.board.name }}</span><h1>{{ appointment.person.full_name }}</h1><div class="hero-badges"><span>{{ appointment.position }}</span>{% if appointment.portfolio %}<span>{{ appointment.portfolio }}</span>{% endif %}<span>{{ appointment.get_level_display }}</span><span>{{ appointment.jurisdiction_name }}</span></div></div><div class="toolbar">{% if appointment.person.whatsapp_number or appointment.person.mobile %}<a class="btn whatsapp" target="_blank" href="https://wa.me/{{ appointment.person.whatsapp_number|default:appointment.person.mobile|cut:'+' }}">WhatsApp</a>{% endif %}<a class="btn secondary" href="{% url 'team_edit' appointment.id %}">Edit</a><a class="btn" href="{% url 'team_list' %}">Back</a></div></div>
+<div class="detail-grid"><section class="card"><h2>Basic information</h2><dl class="info-grid"><div><dt>Phone</dt><dd>{{ appointment.person.mobile|default:'—' }}</dd></div><div><dt>Email</dt><dd>{{ appointment.person.email|default:'—' }}</dd></div><div><dt>Date of birth</dt><dd>{{ appointment.person.date_of_birth|date:'d M Y'|default:'—' }}</dd></div><div><dt>ID type</dt><dd>{{ appointment.person.get_identity_type_display|default:'—' }}</dd></div><div><dt>ID number</dt><dd>{{ appointment.person.identity_number|default:'—' }}</dd></div><div><dt>Jamatkhana</dt><dd>{{ appointment.person.jamatkhana|default:'—' }}</dd></div></dl></section>
+<section class="card"><h2>Appointment</h2><dl class="info-grid"><div><dt>Term</dt><dd>{{ appointment.term }}</dd></div><div><dt>Board</dt><dd>{{ appointment.board }}</dd></div><div><dt>Position</dt><dd>{{ appointment.position }}</dd></div><div><dt>Portfolio</dt><dd>{{ appointment.portfolio|default:'—' }}</dd></div><div><dt>Level</dt><dd>{{ appointment.get_level_display }}</dd></div><div><dt>Jurisdiction</dt><dd>{{ appointment.jurisdiction_name }}</dd></div><div><dt>Appointment date</dt><dd>{{ appointment.appointment_date|date:'d M Y'|default:'—' }}</dd></div><div><dt>End date</dt><dd>{{ appointment.end_date|date:'d M Y'|default:'—' }}</dd></div></dl><h3>JK coverage</h3><div>{% for jk in appointment.covered_jamatkhanas.all %}<span class="mini-badge">{{ jk }}</span>{% empty %}No additional JK coverage{% endfor %}</div></section></div>
+<section class="card"><h2>Service history</h2><div class="table-scroll"><table class="data-table"><thead><tr><th>Term</th><th>Board</th><th>Position</th><th>Portfolio</th><th>Level</th><th>Status</th></tr></thead><tbody>{% for h in history %}<tr><td>{{ h.term }}</td><td>{{ h.board }}</td><td>{{ h.position }}</td><td>{{ h.portfolio|default:'—' }}</td><td>{{ h.get_level_display }}</td><td>{% if h.is_active %}Active{% else %}Completed{% endif %}</td></tr>{% endfor %}</tbody></table></div></section></div>{% endblock %}
