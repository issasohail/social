+{% extends 'base.html' %}{% block title %}{{ title }}{% endblock %}{% block content %}<div class="page-wrap narrow"><div class="page-heading"><div><span class="eyebrow">TEAMS & CONTACTS</span><h1>{{ title }}</h1><p>Select an existing person so contact and identity data remain in one source.</p></div></div><form method="post" class="card form-card">{% csrf_token %}{% if form.non_field_errors %}<div class="message">{{ form.non_field_errors }}</div>{% endif %}<div class="form-grid">{% for field in form %}<label><span>{{ field.label }}</span>{{ field }}{% if field.help_text %}<small>{{ field.help_text }}</small>{% endif %}{{ field.errors }}</label>{% endfor %}</div><div class="toolbar"><button class="btn primary" type="submit">Save appointment</button><a class="btn" href="{% url 'team_list' %}">Cancel</a></div></form></div>{% endblock %}
