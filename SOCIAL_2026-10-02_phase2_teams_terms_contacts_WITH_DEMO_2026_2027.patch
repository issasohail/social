@@ -0,0 +1 @@
+{% extends 'base.html' %}{% block title %}Team Settings{% endblock %}{% block content %}<div class="page-wrap"><div class="page-heading"><div><span class="eyebrow">SETTINGS</span><h1>Team Settings</h1><p>Terms create a fresh appointment cycle while preserving prior teams.</p></div></div><div class="settings-tabs"><a href="?kind=term" class="btn {% if kind == 'term' %}primary{% endif %}">Terms</a><a href="?kind=position" class="btn {% if kind == 'position' %}primary{% endif %}">Positions</a><a href="?kind=portfolio" class="btn {% if kind == 'portfolio' %}primary{% endif %}">Portfolios</a></div><div class="detail-grid"><form method="post" class="card form-card">{% csrf_token %}<h2>{% if form.instance.pk %}Edit{% else %}Add{% endif %} {{ kind }}</h2><div class="form-grid">{% for field in form %}<label><span>{{ field.label }}</span>{{ field }}{{ field.errors }}</label>{% endfor %}</div><button class="btn primary">Save</button></form><section class="card"><h2>Configured {{ kind }}s</h2><table class="data-table"><tbody>{% for item in items %}<tr><td><b>{{ item }}</b>{% if item.is_current %}<span class="mini-badge">Current</span>{% endif %}</td><td>{% if item.is_active %}Active{% else %}Inactive{% endif %}</td><td><a href="?kind={{ kind }}&edit={{ item.id }}">Edit</a></td></tr>{% empty %}<tr><td>No records yet.</td></tr>{% endfor %}</tbody></table></section></div></div>{% endblock %}
