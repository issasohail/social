+{% extends 'base.html' %}{% block title %}Backup & Restore{% endblock %}{% block content %}
+<style>.backup-wrap{max-width:1200px;margin:auto}.backup-top,.backup-card,.backup-list{background:#fff;border:1px solid #dfe7e3;border-radius:10px;padding:16px;margin:14px 0}.backup-actions{display:flex;gap:8px;flex-wrap:wrap}.backup-actions button,.btnx{border:0;border-radius:5px;padding:8px 13px;cursor:pointer}.blue{background:#126bdb;color:#fff}.red{background:#dc3545;color:#fff}.gray{background:#6c757d;color:#fff}.settings-grid{display:grid;grid-template-columns:1.2fr .7fr 1fr 1fr;gap:10px}.settings-grid input[type=text],.settings-grid input[type=number],select,input[type=file]{width:100%;box-sizing:border-box;padding:7px}.checks{grid-column:1/-1;display:flex;gap:14px;flex-wrap:wrap;align-items:center}.backup-table{width:100%;border-collapse:collapse}.backup-table th,.backup-table td{padding:9px;border-bottom:1px solid #e5e8e7;text-align:left;font-size:13px}.available{background:#198754;color:#fff;border-radius:10px;padding:2px 7px}.row-actions{display:flex;gap:5px;flex-wrap:wrap}@media(max-width:760px){.settings-grid{grid-template-columns:1fr}.checks{grid-column:auto}.backup-table{display:block;overflow-x:auto}.backup-actions>*{flex:1}}</style>
+<div class="backup-wrap"><div class="backup-top"><div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap"><div><h1 style="margin:0">Backup & Restore</h1><small>Superuser only. Database, media, code and full Social backups with smart restore.</small></div><div class="backup-actions"><form method="post">{% csrf_token %}<input type="hidden" name="action" value="backup_db"><button class="blue">Backup DB</button></form><form method="post">{% csrf_token %}<input type="hidden" name="action" value="backup_media"><button class="blue">Backup Media</button></form><form method="post">{% csrf_token %}<input type="hidden" name="action" value="backup_code"><button class="gray">Backup Code</button></form><form method="post">{% csrf_token %}<input type="hidden" name="action" value="backup_full"><button class="red">Full Backup</button></form></div></div></div>
+<div class="backup-card"><h3>Backup Settings, Upload & Smart Restore</h3><form method="post" class="settings-grid">{% csrf_token %}<input type="hidden" name="action" value="save_backup_settings"><label>Backup Root Folder{{ settings_form.backup_root }}</label><label>Retention Count{{ settings_form.retention_count }}</label><label>mysqldump Path{{ settings_form.mysqldump_path }}</label><label>mysql Path{{ settings_form.mysql_path }}</label><div class="checks"><label>{{ settings_form.include_db_in_full }} Include DB in Full</label><label>{{ settings_form.include_media_in_full }} Include Media in Full</label><label>{{ settings_form.include_code_in_full }} Include Code in Full</label><label>{{ settings_form.compress_backups }} Compress DB (GZIP)</label><label>{{ settings_form.auto_delete_old_backups }} Delete Old Automatically</label><label>{{ settings_form.enable_db_backup }} Enable DB</label><label>{{ settings_form.enable_media_backup }} Enable Media</label><label>{{ settings_form.enable_code_backup }} Enable Code</label><label>{{ settings_form.enable_full_backup }} Enable Full</label><button class="blue btnx">Save Settings</button></div></form><hr><div style="display:grid;grid-template-columns:1fr 1fr;gap:16px"><form method="post" enctype="multipart/form-data">{% csrf_token %}<input type="hidden" name="action" value="upload_backup"><b>Upload for Restore</b>{{ upload_form.backup_file }}<button class="blue btnx">Upload Backup</button></form><form method="post" onsubmit="return confirm('Restore selected backup? A safety backup will be created first.')">{% csrf_token %}<input type="hidden" name="action" value="restore"><b>Smart Restore</b><select name="backup_id" required><option value="">----------</option>{% for b in backups %}{% if b.file_exists and b.backup_type != 'code' %}<option value="{{ b.id }}">#{{ b.serial_number }} {{ b.get_backup_type_display }} · {{ b.name }}</option>{% endif %}{% endfor %}</select><button class="red btnx">Restore Selected Backup</button></form></div></div>
+<div class="backup-list"><div style="display:flex;justify-content:space-between"><h3>Latest Available Backups</h3><small>Newest first</small></div><table class="backup-table"><thead><tr><th>#</th><th>Name</th><th>Type</th><th>Status</th><th>Size</th><th>Created</th><th>Storage</th><th>Actions</th></tr></thead><tbody>{% for b in backups %}<tr><td>{{ b.serial_number }}</td><td>{{ b.name }}</td><td>{{ b.get_backup_type_display }}</td><td>{% if b.file_exists %}<span class="available">Available</span>{% else %}Missing{% endif %}</td><td>{{ b.human_size }}</td><td>{{ b.created_at|date:'Y-m-d H:i:s' }}</td><td>{{ b.get_storage_mode_display }}</td><td><div class="row-actions">{% if b.file_exists %}<a class="blue btnx" href="{% url 'backup_download' b.id %}">Download</a>{% endif %}{% if b.is_protected %}<span class="gray btnx">Protected</span>{% else %}<form method="post" action="{% url 'backup_delete' b.id %}" onsubmit="return confirm('Delete this backup?')">{% csrf_token %}<button class="red btnx">Delete</button></form>{% endif %}</div></td></tr>{% empty %}<tr><td colspan="8">No backups yet.</td></tr>{% endfor %}</tbody></table><div style="margin-top:12px"><b>Backup files:</b> {{ storage.backup_bytes|filesizeformat }} &nbsp; <b>Available disk:</b> {{ storage.disk_free|filesizeformat }} <form method="post" style="display:inline;float:right" onsubmit="return confirm('Purge old backups beyond retention count?')">{% csrf_token %}<input type="hidden" name="action" value="purge"><button class="red btnx">Purge Old Backups</button></form></div></div></div>{% endblock %}

