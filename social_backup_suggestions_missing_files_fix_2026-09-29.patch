diff --git a/settings_app/tool_views.py b/settings_app/tool_views.py
new file mode 100644
index 0000000..1820ad2
--- /dev/null
+++ b/settings_app/tool_views.py
@@ -0,0 +1,88 @@
+from urllib.parse import quote
+from django.contrib import messages
+from django.contrib.auth.decorators import login_required, user_passes_test
+from django.http import FileResponse, Http404
+from django.shortcuts import redirect, render
+from django.views.decorators.http import require_POST
+from .forms_tools import BackupSettingsForm, BackupUploadForm, SuggestionTicketForm
+from .backup_utils import *
+from .suggestion_store import create_ticket, get_ticket, list_tickets, delete_ticket, STATUS_CHOICES, TYPE_CHOICES
+
+superuser_required=user_passes_test(lambda u:u.is_superuser)
+
+@login_required
+@superuser_required
+def backup_center(request):
+    config=load_backup_settings()
+    if request.method=='POST':
+        action=request.POST.get('action')
+        try:
+            if action=='save_backup_settings':
+                form=BackupSettingsForm(request.POST)
+                if form.is_valid(): save_backup_settings(form.cleaned_data); messages.success(request,'Backup settings saved.')
+                else: messages.error(request,'Please correct the backup settings.')
+            elif action=='upload_backup':
+                form=BackupUploadForm(request.POST,request.FILES)
+                if form.is_valid():
+                    typ=detect_uploaded_backup_type(form.cleaned_data['backup_file']); p=save_uploaded_backup(config,typ,form.cleaned_data['backup_file']); messages.success(request,f'Backup uploaded: {p.name}')
+                else: messages.error(request,'Choose a valid backup file.')
+            elif action=='backup_db': p=create_db_backup(config); prune_old_backups(config); messages.success(request,f'Database backup created: {p.name}')
+            elif action=='backup_media': p=create_media_backup(config); prune_old_backups(config); messages.success(request,f'Media backup created: {p.name}')
+            elif action=='backup_code': p=create_code_backup(config); prune_old_backups(config); messages.success(request,f'Code backup created: {p.name}')
+            elif action=='backup_full': p=create_full_backup(config); prune_old_backups(config); messages.success(request,f'Full backup created: {p.name}')
+            elif action=='purge':
+                result=purge_old_backups(config); messages.success(request,f"Purged {len(result['deleted'])} old backup(s).")
+            elif action=='restore':
+                bid=request.POST.get('backup_id',''); item=next((x for x in list_backups(config) if x.id==bid),None)
+                if not item: raise RuntimeError('Select a valid backup.')
+                if item.backup_type=='db': create_db_backup({**config,'enable_db_backup':True}); restore_database(config,bid)
+                elif item.backup_type=='media': create_media_backup({**config,'enable_media_backup':True}); restore_media(config,bid)
+                elif item.backup_type=='full': create_full_backup({**config,'enable_full_backup':True}); restore_full(config,bid)
+                else: raise RuntimeError('This backup type cannot be restored here.')
+                messages.success(request,'Restore completed. A safety backup was created first.')
+        except Exception as exc: messages.error(request,f'Backup operation failed: {exc}')
+        return redirect('backup_center')
+    config=load_backup_settings(); backups=list_backups(config); protected=protected_backup_ids(backups,retention_count(config))
+    for i,b in enumerate(backups,1): b.serial_number=i; b.is_protected=b.id in protected
+    return render(request,'settings_app/backup_center.html',{'settings_form':BackupSettingsForm(initial=config),'upload_form':BackupUploadForm(),'backups':backups,'storage':backup_storage_summary(config)})
+
+@login_required
+@superuser_required
+def backup_download(request,backup_id):
+    config=load_backup_settings(); item=next((x for x in list_backups(config) if x.id==backup_id and x.file_exists),None)
+    if not item: raise Http404
+    return FileResponse(open(item.display_path,'rb'),as_attachment=True,filename=backup_id)
+
+@login_required
+@superuser_required
+@require_POST
+def backup_delete(request,backup_id):
+    try: delete_backup(load_backup_settings(),backup_id); messages.success(request,'Backup deleted.')
+    except Exception as exc: messages.error(request,str(exc))
+    return redirect('backup_center')
+
+@login_required
+def suggestion_list(request):
+    status=request.GET.get('status','PENDING'); typ=request.GET.get('type','')
+    return render(request,'settings_app/suggestions/list.html',{'tickets':list_tickets(status=status or None,ticket_type=typ or None),'statuses':STATUS_CHOICES,'types':TYPE_CHOICES,'selected_status':status,'selected_type':typ})
+
+@login_required
+def suggestion_create(request):
+    form=SuggestionTicketForm(request.POST or None)
+    if request.method=='POST' and form.is_valid():
+        ticket=create_ticket(form.cleaned_data,request.user,request.FILES.getlist('photos')); messages.success(request,'Suggestion saved.'); return redirect('suggestion_detail',pk=ticket.id)
+    return render(request,'settings_app/suggestions/form.html',{'form':form})
+
+@login_required
+def suggestion_detail(request,pk):
+    ticket=get_ticket(pk)
+    if not ticket: raise Http404
+    return render(request,'settings_app/suggestions/detail.html',{'ticket':ticket})
+
+@login_required
+@require_POST
+def suggestion_delete(request,pk):
+    ticket=get_ticket(pk)
+    if not ticket: raise Http404
+    if not (request.user.is_staff or request.user.is_superuser or ticket.user_name_snapshot==request.user.get_username()): raise Http404
+    delete_ticket(pk); messages.success(request,'Suggestion deleted.'); return redirect('suggestion_list')
