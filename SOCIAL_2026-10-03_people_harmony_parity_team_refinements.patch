+{{ portfolio_map|json_script:"team-portfolio-map" }}
+{% endblock %}
+{% block extra_js %}<script>
+(function(){
+  const parse=id=>{const el=document.getElementById(id);return el?JSON.parse(el.textContent):{}};
+  const regionMap=parse('team-region-map'), localMap=parse('team-local-map'), jkMap=parse('team-jk-map'), portfolioMap=parse('team-portfolio-map');
+  const by=id=>document.getElementById(id);
+  const setSelect=(el,value)=>{if(!el||!value)return; el.value=String(value); el.dispatchEvent(new Event('change',{bubbles:true})); const wrap=el.closest('.select2-lite'); if(wrap){const input=wrap.querySelector('.select2-lite-input'); const option=Array.from(el.options).find(o=>o.value===String(value)); if(input&&option)input.value=option.text;}};
+  const national=by('id_national_council'), regional=by('id_regional_council'), local=by('id_local_council'), jk=by('id_jamatkhana');
+  if(regional)regional.addEventListener('change',()=>{const m=regionMap[regional.value];if(m)setSelect(national,m.national)});
+  if(local)local.addEventListener('change',()=>{const m=localMap[local.value];if(m){setSelect(regional,m.regional);setSelect(national,m.national)}});
+  if(jk)jk.addEventListener('change',()=>{const m=jkMap[jk.value];if(m){setSelect(local,m.local);setSelect(regional,m.regional);setSelect(national,m.national)}});
+  const board=by('id_board'), portfolio=by('id_portfolio');
+  function filterPortfolios(){
+    if(!board||!portfolio)return;
+    const boardId=board.value;
+    Array.from(portfolio.options).forEach(o=>{if(!o.value)return;o.hidden=!!boardId&&String(portfolioMap[o.value]?.board)!==String(boardId)});
+    const wrap=portfolio.closest('.select2-lite');
+    if(wrap)wrap.querySelectorAll('.select2-lite-option').forEach(item=>{item.hidden=!!boardId&&String(portfolioMap[item.dataset.value]?.board)!==String(boardId)});
+    if(portfolio.value && boardId && String(portfolioMap[portfolio.value]?.board)!==String(boardId)){portfolio.value='';const input=wrap?.querySelector('.select2-lite-input');if(input)input.value='';}
+  }
+  if(board){board.addEventListener('change',filterPortfolios);filterPortfolios();}
+})();
+</script>{% endblock %}
