{% extends 'base.html' %}
{% load static %}
{% block title %}Family Harmony | Social Welfare{% endblock %}
{% block extra_css %}<link rel="stylesheet" href="{% static 'app.css' %}?v=harmony-link-modal-20261002-3">{% endblock %}
{% block content %}
<section class="people-mockup harmony-list">
  <datalist id="profession-options">{% for item in profession_options %}<option value="{{ item }}">{% endfor %}</datalist>
  <header class="people-hero"><div><h1><span>&#9825;</span> Family Harmony</h1></div><div class="people-hero-actions">{% include 'partials/public_marriage_actions.html' %}<button class="people-btn marriage" id="openLinkProfile" type="button">&#128279; Link Profile</button><a class="people-btn add" href="{% url 'harmony_create' %}?new=1">&#43; New Profile</a></div></header>
  <div class="people-stats harmony-stats"><div class="people-stat teal"><b>&#9825;</b><strong>{{ profile_total }}</strong><span>Total profiles</span></div><div class="people-stat green"><b>&#10003;</b><strong>{{ profile_approved }}</strong><span>Active</span></div><div class="people-stat orange"><b>&#9201;</b><strong>{{ profile_pending }}</strong><span>Awaiting consent</span></div><div class="people-stat blue"><b>&#9794;</b><strong>{{ profile_male }}</strong><span>Male</span></div><div class="people-stat pink"><b>&#9792;</b><strong>{{ profile_female }}</strong><span>Female</span></div></div>
  <section class="people-filter-panel harmony-filter-panel"><form class="people-filter harmony-filter" method="get" id="harmonyFilters"><label class="people-search"><span>&#8981;</span><input name="q" value="{{ query }}" placeholder="Search by name, phone or city..."></label><select name="status"><option value="">All statuses</option>{% for value,label in statuses %}<option value="{{ value }}" {% if status == value %}selected{% endif %}>{{ label }}</option>{% endfor %}</select><select name="gender"><option value="">All genders</option><option value="Female" {% if gender == 'Female' %}selected{% endif %}>Female</option><option value="Male" {% if gender == 'Male' %}selected{% endif %}>Male</option></select><select name="local_council"><option value="">All local councils</option>{% for local in local_councils %}<option value="{{ local.id }}" {% if local_council == local.id|stringformat:'s' %}selected{% endif %}>{{ local.name }}</option>{% endfor %}</select><select name="jamatkhana"><option value="">All jamatkhanas</option>{% for jk in jamatkhanas %}<option value="{{ jk.id }}" {% if jamatkhana == jk.id|stringformat:'s' %}selected{% endif %}>{{ jk.name }}</option>{% endfor %}</select><button class="people-filter-button" type="submit">&#9776; Filters</button><details class="harmony-advanced"><summary>More filters <span>&#8964;</span></summary><div class="harmony-advanced-grid"><input name="city" value="{{ city }}" placeholder="City"><input name="profession" value="{{ profession }}" placeholder="Profession"><select name="education"><option value="">All education levels</option>{% for item in education_options %}<option value="{{ item }}" {% if request.GET.education == item %}selected{% endif %}>{{ item }}</option>{% endfor %}</select><select name="house"><option value="">Any house</option><option value="yes" {% if request.GET.house == 'yes' %}selected{% endif %}>Owned</option><option value="no" {% if request.GET.house == 'no' %}selected{% endif %}>Rented</option></select><select name="car"><option value="">Any car</option><option value="yes" {% if request.GET.car == 'yes' %}selected{% endif %}>Has car</option><option value="no" {% if request.GET.car == 'no' %}selected{% endif %}>No car</option></select><select name="portfolio"><option value="">All portfolios</option>{% for item in portfolio_options %}<option value="{{ item }}" {% if portfolio == item %}selected{% endif %}>{{ item }}</option>{% endfor %}</select></div></details></form>
  <div class="people-chips harmony-chips" id="harmonyActiveFilters">{% if query %}<button type="button" data-filter="q">Search: {{ query }} <i>&times;</i></button>{% endif %}{% if status %}<button type="button" data-filter="status">{{ status|title }} <i>&times;</i></button>{% endif %}{% if gender %}<button type="button" data-filter="gender">{{ gender }} <i>&times;</i></button>{% endif %}{% if city %}<button type="button" data-filter="city">{{ city }} <i>&times;</i></button>{% endif %}{% if profession %}<button type="button" data-filter="profession">{{ profession }} <i>&times;</i></button>{% endif %}{% if request.GET.education %}<button type="button" data-filter="education">{{ request.GET.education }} <i>&times;</i></button>{% endif %}{% if local_council %}<button type="button" data-filter="local_council">Local council <i>&times;</i></button>{% endif %}{% if jamatkhana %}<button type="button" data-filter="jamatkhana">Jamatkhana <i>&times;</i></button>{% endif %}{% if request.GET.house %}<button type="button" data-filter="house">House: {{ request.GET.house|title }} <i>&times;</i></button>{% endif %}{% if request.GET.car %}<button type="button" data-filter="car">Car: {{ request.GET.car|title }} <i>&times;</i></button>{% endif %}{% if portfolio %}<button type="button" data-filter="portfolio">{{ portfolio }} <i>&times;</i></button>{% endif %}{% if request.GET %}<a href="{% url 'family_harmony' %}">Clear all</a>{% endif %}</div></section>
  <section class="people-list-card list-results"><header class="people-list-header"><h2>Family Harmony <small>({{ profile_total }})</small></h2><div><a class="people-icon-button" href="?{{ request.GET.urlencode }}{% if request.GET %}&{% endif %}format=pdf">PDF</a><a class="people-icon-button" href="?{{ request.GET.urlencode }}{% if request.GET %}&{% endif %}format=xlsx">&#8681; Export</a></div></header><div class="people-table-wrap"><table class="people-table sortable-table"><thead><tr><th>#</th><th>Photo</th><th data-sort="name">Name</th><th data-sort="age">Age</th><th data-sort="gender">Gender</th><th data-sort="city">City</th><th data-sort="phone">Phone / WhatsApp</th><th data-sort="education">Education</th><th>House</th><th>Car</th><th>Current LC</th><th data-sort="profession">Profession</th><th data-sort="status">Status</th><th>Actions</th></tr></thead><tbody>{% for profile in profiles %}<tr><td>{{ forloop.counter }}</td><td>{% if profile.person.photo %}<img class="people-avatar" src="{{ profile.person.photo.url }}" alt="{{ profile.person.full_name }}">{% else %}<span class="people-avatar initials">{{ profile.person.first_name|first }}{{ profile.person.last_name|first }}</span>{% endif %}</td><td><a class="people-name" href="{% url 'harmony_detail' profile.id %}">{{ profile.person.full_name }}</a><small>{{ profile.serial_number }}</small></td><td>{{ profile.person.age|default:'—' }}</td><td><a class="tag {{ profile.person.gender|lower }}" href="?gender={{ profile.person.gender|urlencode }}">{{ profile.person.gender|default:'—' }}</a></td><td><a class="people-cell-link" href="?city={{ profile.person.city|urlencode }}">{{ profile.person.city|default:'—' }}</a></td><td>{% if profile.person.whatsapp_number or profile.person.mobile %}<a class="phone-whatsapp" target="_blank" rel="noopener" href="https://wa.me/{{ profile.person.whatsapp_number|default:profile.person.mobile|cut:'+'|cut:'-'|cut:' ' }}?text=Hello%20{{ profile.person.full_name|urlencode }}">{{ profile.person.whatsapp_number|default:profile.person.mobile }}</a>{% else %}—{% endif %}</td><td><span class="tag education">{{ profile.education_level|default:profile.person.education|default:'—' }}</span></td><td><span class="tag house">{{ profile.owns_house|yesno:'Owned,Rented,—' }}</span></td><td><span class="tag car">{{ profile.owns_car|yesno:'Yes,No,—' }}</span></td><td>{{ profile.owning_local_council|default:'—' }}</td><td>{{ profile.profession|default:profile.person.occupation|default:'—' }}</td><td><a class="tag status" href="?status={{ profile.status }}">{{ profile.get_status_display }}</a></td><td class="people-row-actions"><a href="{% url 'harmony_detail' profile.id %}" title="View">&#9673;</a><a href="{% url 'harmony_edit' profile.id %}" title="Edit">&#9998;</a><a href="{% url 'create_profile_share' profile.id %}?redirect=whatsapp" target="_blank" rel="noopener" class="wa" title="Share secure read-only link on WhatsApp">&#128172;</a><a href="{% url 'harmony_export' profile.id 'jpg' %}" class="text-action jpg-action" download title="Download JPG">JPG</a><a href="{% url 'harmony_export' profile.id 'pdf' %}" class="text-action pdf-action" download title="Download PDF">PDF</a></td></tr>{% empty %}<tr><td colspan="14" class="people-empty">No profiles found. Try changing or clearing the filters.</td></tr>{% endfor %}</tbody></table></div>
  <div class="people-mobile-list">{% for profile in profiles %}<article class="people-mobile-card"><a class="mobile-card-top" href="{% url 'harmony_detail' profile.id %}">{% if profile.person.photo %}<img class="people-avatar" src="{{ profile.person.photo.url }}" alt="">{% else %}<span class="people-avatar initials">{{ profile.person.first_name|first }}{{ profile.person.last_name|first }}</span>{% endif %}<div><strong class="people-name">{{ profile.person.full_name }}</strong><small>{{ profile.serial_number }} · Age {{ profile.person.age|default:'—' }}</small><div class="mobile-tags"><span class="tag {{ profile.person.gender|lower }}">{{ profile.person.gender|default:'—' }}</span><span>📍 {{ profile.person.city|default:'—' }}</span><span class="tag education">{{ profile.education_level|default:'—' }}</span><span class="tag house">{{ profile.owns_house|yesno:'Owned,Rented,—' }}</span></div></div><span class="arrow">›</span></a><div class="mobile-card-actions"><a href="{% url 'harmony_detail' profile.id %}">View</a><a href="{% url 'harmony_edit' profile.id %}">Edit</a><a href="{% url 'create_profile_share' profile.id %}?redirect=whatsapp" target="_blank" rel="noopener">WhatsApp</a><a href="{% url 'harmony_export' profile.id 'jpg' %}" download>JPG</a><a href="{% url 'harmony_export' profile.id 'pdf' %}" download>PDF</a></div></article>{% empty %}<p class="people-empty">No profiles found.</p>{% endfor %}</div>{% include 'partials/pagination.html' %}</section>
</section>
<div class="harmony-link-modal" id="linkProfileModal" hidden><div class="harmony-link-backdrop" data-close-link-modal></div><section class="harmony-link-dialog" role="dialog" aria-modal="true" aria-labelledby="linkProfileTitle"><button class="harmony-link-close" type="button" data-close-link-modal aria-label="Close">&times;</button><h2 id="linkProfileTitle">Link a People record</h2><p>Search, select a person, then enter their match preferences.</p><input id="linkPersonSearch" type="search" placeholder="Search name, phone, Jamatkhana, local council, or regional council"><div id="linkPersonResults" class="harmony-link-results"></div><form id="linkPreferenceForm" method="post" action="{% url 'harmony_link_with_preferences' %}" hidden>{% csrf_token %}<input type="hidden" name="person_id" id="linkPersonId"><div class="harmony-selected-person" id="selectedLinkPerson"></div><h3>Preferences for Prospective Match</h3><div class="harmony-preference-grid">{% for field in link_preference_form %}<div class="harmony-preference-field"><label for="{{ field.id_for_label }}">{{ field.label }}</label>{{ field }}{{ field.errors }}</div>{% endfor %}</div><div class="harmony-link-actions"><button type="button" class="secondary" data-close-link-modal>Cancel</button><button type="submit" class="people-btn add">Save Profile &amp; Preferences</button></div></form></section></div>
{{ link_people|json_script:"link-people-data" }}
<script>(function(){const modal=document.getElementById('linkProfileModal'),open=document.getElementById('openLinkProfile'),search=document.getElementById('linkPersonSearch'),results=document.getElementById('linkPersonResults'),form=document.getElementById('linkPreferenceForm'),people=JSON.parse(document.getElementById('link-people-data').textContent);const close=()=>modal.hidden=true;const render=term=>{const needle=term.toLowerCase();const matches=people.filter(p=>Object.values(p).join(' ').toLowerCase().includes(needle)).slice(0,50);results.innerHTML=matches.length?matches.map(p=>`<button type="button" data-id="${p.id}"><b>${p.full_name}</b><small>${p.mobile||p.whatsapp_number||'No phone'} · ${p.jamatkhana__name||'No JK'} · ${p.jamatkhana__local_council__name||'No LC'} · ${p.jamatkhana__local_council__regional_council__name||'No RC'}</small></button>`).join(''):'<p>No unlinked People record found.</p>';results.querySelectorAll('button').forEach(b=>b.onclick=()=>{const p=people.find(x=>x.id===Number(b.dataset.id));document.getElementById('linkPersonId').value=p.id;document.getElementById('selectedLinkPerson').textContent=`Selected: ${p.full_name} · ${p.mobile||p.whatsapp_number||'No phone'} · ${p.jamatkhana__name||'No JK'}`;form.hidden=false;results.hidden=true;search.hidden=true})};open.onclick=()=>{modal.hidden=false;form.hidden=true;results.hidden=false;search.hidden=false;search.value='';render('');search.focus()};search.oninput=()=>render(search.value);modal.querySelectorAll('[data-close-link-modal]').forEach(b=>b.onclick=close);document.querySelectorAll('.people-table .tag.status').forEach(tag=>tag.addEventListener('click',e=>{e.preventDefault();if(tag.querySelector('select'))return;const row=tag.closest('tr'),view=row.querySelector('.people-row-actions a[href*="family-harmony/"]'),match=view&&view.href.match(/family-harmony\/(\d+)/);if(!match)return;const old=tag.textContent.trim(),select=document.createElement('select');{% for value,label in statuses %}select.add(new Option('{{ label|escapejs }}','{{ value|escapejs }}',false,'{{ label|escapejs }}'===old));{% endfor %}tag.replaceChildren(select);select.focus();select.onchange=async()=>{const fd=new FormData;fd.append('profile_id',match[1]);fd.append('field','status');fd.append('value',select.value);fd.append('csrfmiddlewaretoken','{{ csrf_token }}');const r=await fetch('{% url "harmony_inline_update" %}',{method:'POST',body:fd});tag.textContent=r.ok?select.options[select.selectedIndex].text:old};select.onblur=()=>{if(tag.querySelector('select'))tag.textContent=old}}));})();</script>
{% endblock %}
{% block extra_js %}<script>document.querySelectorAll('.sortable-table th[data-sort]').forEach(h=>h.onclick=()=>{const u=new URL(location);const same=u.searchParams.get('sort')===h.dataset.sort;u.searchParams.set('sort',h.dataset.sort);u.searchParams.set('dir',same&&u.searchParams.get('dir')!=='desc'?'desc':'asc');u.searchParams.delete('page');location=u});document.querySelectorAll('#harmonyActiveFilters button[data-filter]').forEach(b=>b.addEventListener('click',()=>{const u=new URL(location);u.searchParams.delete(b.dataset.filter);u.searchParams.delete('page');location=u}));const filters=document.getElementById('harmonyFilters');if(filters){let timer;const submit=()=>{clearTimeout(timer);filters.requestSubmit()};filters.querySelectorAll('select').forEach(el=>el.addEventListener('change',submit));filters.querySelectorAll('input').forEach(el=>el.addEventListener('input',()=>{clearTimeout(timer);timer=setTimeout(()=>filters.requestSubmit(),500)}));const profession=filters.querySelector('[name="profession"]');if(profession)profession.setAttribute('list','profession-options');}</script>{% endblock %}
