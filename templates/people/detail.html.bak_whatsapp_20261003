{% extends 'base.html' %}{% load static %}
{% block extra_css %}<link rel="stylesheet" href="{% static 'family_harmony_detail.css' %}?v=people-detail-20261002-1">{% endblock %}
{% block title %}{{ person.full_name }} | Social Welfare{% endblock %}
{% block content %}
<datalist id="person-detail-occupation-options">{% for item in occupation_options %}<option value="{{ item }}">{% endfor %}</datalist>
<article class="marriage-biodata harmony-detail people-detail">
  <header class="marriage-biodata-head">
    {% if person.photo %}<img class="marriage-biodata-photo" src="{{ person.photo.url }}" alt="{{ person.full_name }}">{% else %}<div class="marriage-biodata-photo placeholder">{{ person.first_name|first }}</div>{% endif %}
    <div class="harmony-head-name">
      <p class="eyebrow">AGA KHAN SOCIAL WELFARE BOARD · CENTRAL REGION</p>
      <h1>{{ person.full_name }}</h1>
      <div class="biodata-badges"><span>{{ person.age|default:'—' }} yrs</span><span>{{ person.gender|default:'—' }}</span><span>{{ person.marital_status|default:'—' }}</span><span>{{ person.serial_number }}</span></div>
      {% if person.whatsapp_number or person.mobile %}<a class="harmony-primary-phone" target="_blank" rel="noopener" href="https://wa.me/{{ person.whatsapp_number|default:person.mobile|cut:'+'|cut:'-'|cut:' ' }}?text=Hello%20{{ person.full_name|urlencode }}">◉ {{ person.whatsapp_number|default:person.mobile }}</a>{% endif %}
    </div>
    <div class="harmony-head-right">
      <div class="biodata-actions">
        <a class="primary" href="{% url 'person_edit' person.id %}">Edit</a>
        <a class="action-button whatsapp" href="{% url 'create_person_share' person.id %}" target="_blank" rel="noopener" title="Share a secure read-only profile link on WhatsApp">WhatsApp</a>
        <a class="action-button pdf" href="{% url 'person_export' person.id 'pdf' %}" download>PDF</a>
        <a class="secondary biodata-jpg" href="{% url 'person_export' person.id 'jpg' %}" download>Export JPG</a>
        {% if person.harmony_profile %}<a class="secondary" href="{% url 'harmony_detail' person.harmony_profile.id %}">Family Harmony</a>{% endif %}
        <a class="secondary biodata-archive" href="{% url 'person_delete' person.id %}">Archive</a>
      </div>
      <div class="harmony-head-contact">
        <strong>{% if person.jamatkhana %}{{ person.jamatkhana.name }}{% else %}Jamatkhana not set{% endif %}{% if person.local_council %} · {{ person.local_council.name }}{% endif %}{% if person.region %} · {{ person.region.name }}{% endif %}</strong>
        <span>DOB: {{ person.date_of_birth|date:'j M Y'|default:'—' }} · {{ person.city|default:'—' }} / {{ person.country|default:'—' }}</span>
        <span>{{ person.email|default:'—' }}</span>
      </div>
    </div>
  </header>
  <p class="inline-edit-help">Click an editable value to update it. Changes save automatically when you leave the field.</p>
  <section class="biodata-section personal-detail-section"><h2>Personal Information</h2><div class="biodata-grid">
    <div class="biodata-item"><small>Date of Birth</small><strong>{{ person.date_of_birth|date:'Y-m-d'|default:'—' }}</strong></div>
    <div class="biodata-item"><small>Gender</small><strong class="inline-value" data-field="gender">{{ person.gender|default:'—' }}</strong></div>
    <div class="biodata-item"><small>Marital Status</small><strong class="inline-value" data-field="marital_status">{{ person.marital_status|default:'—' }}</strong></div>
    <div class="biodata-item"><small>Nationality</small><strong class="inline-value" data-field="nationality">{{ person.nationality|default:'—' }}</strong></div>
    <div class="biodata-item"><small>Identity Type</small><strong>{{ person.get_identity_type_display|default:'—' }}</strong></div>
    <div class="biodata-item"><small>Identity Number</small><strong>{{ person.masked_identity_number|default:'—' }}</strong></div>
    <div class="biodata-item"><small>Mobile</small><strong class="inline-value" data-field="mobile">{{ person.mobile|default:'—' }}</strong></div>
    <div class="biodata-item"><small>WhatsApp</small><strong class="inline-value" data-field="whatsapp_number">{{ person.whatsapp_number|default:'—' }}</strong></div>
    <div class="biodata-item"><small>Email</small><strong class="inline-value" data-field="email">{{ person.email|default:'—' }}</strong></div>
    <div class="biodata-item"><small>City</small><strong class="inline-value" data-field="city">{{ person.city|default:'—' }}</strong></div>
    <div class="biodata-item"><small>Country</small><strong>{{ person.country|default:'—' }}</strong></div>
    <div class="biodata-item"><small>Jamatkhana</small><strong>{{ person.jamatkhana|default:'—' }}</strong></div>
    <div class="biodata-item wide"><small>Current Address</small><strong class="inline-value" data-field="current_address">{{ person.current_address|default:'—' }}</strong></div>
    <div class="biodata-item wide"><small>Permanent Address</small><strong class="inline-value" data-field="permanent_address">{{ person.permanent_address|default:'—' }}</strong></div>
  </div></section>
  <section class="biodata-section"><h2>Organization</h2><div class="biodata-grid">
    <div class="biodata-item"><small>Regional Council</small><strong>{{ person.region|default:'—' }}</strong></div>
    <div class="biodata-item"><small>Local Council</small><strong>{{ person.local_council|default:'—' }}</strong></div>
    <div class="biodata-item"><small>Jamatkhana</small><strong>{{ person.jamatkhana|default:'—' }}</strong></div>
  </div></section>
  <section class="biodata-section"><h2>Education &amp; Career</h2><div class="biodata-grid">
    <div class="biodata-item"><small>Education</small><strong class="inline-value" data-field="education">{{ person.education|default:'—' }}</strong></div>
    <div class="biodata-item"><small>Occupation</small><strong class="inline-value" data-field="occupation">{{ person.occupation|default:'—' }}</strong></div>
    <div class="biodata-item"><small>Employer / Business</small><strong class="inline-value" data-field="employer_or_business">{{ person.employer_or_business|default:'—' }}</strong></div>
    <div class="biodata-item"><small>Income Range</small><strong class="inline-value" data-field="income_range">{{ person.income_range|default:'—' }}</strong></div>
    <div class="biodata-item"><small>Willing to Relocate</small><strong>{{ person.willing_to_relocate|yesno:'Yes,No,—' }}</strong></div>
    <div class="biodata-item wide"><small>Education Details</small><strong class="inline-value" data-field="education_details">{{ person.education_details|default:'—' }}</strong></div>
    <div class="biodata-item wide"><small>Languages</small><strong class="inline-value" data-field="languages">{{ person.languages|default:'—' }}</strong></div>
    <div class="biodata-item wide"><small>Interests</small><strong class="inline-value" data-field="interests">{{ person.interests|default:'—' }}</strong></div>
  </div></section>
  <section class="biodata-section"><h2>Documents</h2><div class="biodata-grid">
    <div class="biodata-item"><small>CNIC Front</small><strong>{% if person.cnic_front %}<a href="{{ person.cnic_front.url }}" target="_blank" rel="noopener">View image</a>{% else %}—{% endif %}</strong></div>
    <div class="biodata-item"><small>CNIC Back</small><strong>{% if person.cnic_back %}<a href="{{ person.cnic_back.url }}" target="_blank" rel="noopener">View image</a>{% else %}—{% endif %}</strong></div>
  </div></section>
</article>
{% endblock %}
{% block extra_js %}<script>document.querySelectorAll('.inline-value').forEach(el=>el.onclick=()=>{if(el.querySelector('input'))return;const old=el.textContent.trim()==='—'?'':el.textContent.trim(),input=document.createElement('input');input.value=old;if(el.dataset.field==='occupation')input.setAttribute('list','person-detail-occupation-options');el.textContent='';el.append(input);input.focus();const save=async()=>{const fd=new FormData;fd.append('person_id','{{ person.id }}');fd.append('field',el.dataset.field);fd.append('value',input.value);fd.append('csrfmiddlewaretoken','{{ csrf_token }}');const r=await fetch('{% url "inline_update_person" %}',{method:'POST',body:fd});el.textContent=r.ok?(input.value||'—'):old};input.onblur=save;input.onkeydown=e=>{if(e.key==='Enter')input.blur();if(e.key==='Escape'){el.textContent=old||'—'}}})</script>{% endblock %}
