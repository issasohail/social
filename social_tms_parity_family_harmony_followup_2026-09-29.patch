+              {{ backup_settings_form.retention_count }}
+            </div>
+            <div class="backup-control-item">
+              <label class="form-label small mb-1">mysqldump Path <button type="button" class="backup-help" data-bs-toggle="modal" data-bs-target="#mysqldumpHelpModal" aria-label="mysqldump help"><i class="bi bi-question-circle"></i></button></label>
