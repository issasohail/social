+{% block extra_js %}
+<script>
+const backupSettingsForm = document.getElementById("backupSettingsForm");
+if (backupSettingsForm) {
+  backupSettingsForm.querySelectorAll('input:not([type="hidden"]), select, textarea').forEach(function (field) {
+    field.addEventListener("change", function () {
+      if (backupSettingsForm.dataset.submitting === "true") return;
+      if (!backupSettingsForm.checkValidity()) {
+        backupSettingsForm.reportValidity();
+        return;
+      }
+      backupSettingsForm.dataset.submitting = "true";
+      const saveButton = backupSettingsForm.querySelector('.backup-save-settings');
+      if (saveButton) {
+        saveButton.disabled = true;
+        saveButton.textContent = "Saving...";
+      }
+      backupSettingsForm.requestSubmit();
+    });
+  });
+}
+
+document.querySelectorAll(".js-long-operation").forEach(function (form) {
+  form.addEventListener("submit", function (event) {
+    if (!form.checkValidity()) return;
+    event.preventDefault();
+    const confirmation = form.dataset.confirmMessage;
+    if (confirmation && !window.confirm(confirmation)) return;
+    const overlay = document.getElementById("backupProgressOverlay");
+    const title = document.getElementById("backupProgressTitle");
+    const message = document.getElementById("backupProgressMessage");
+    const timer = document.getElementById("backupProgressTimer");
+    const logoutWarning = document.getElementById("backupRestoreLogoutWarning");
+    const label = form.dataset.operationLabel || "Backup operation";
+    const isRestore = form.dataset.isRestore === "true";
+    title.textContent = label + " in progress";
+    message.textContent = isRestore
+      ? "TMS is creating a safety backup and restoring the selected data."
+      : "Social Welfare is preparing and saving your backup.";
+    if (logoutWarning) {
+      logoutWarning.classList.toggle("d-none", !isRestore);
+    }
+    overlay.classList.remove("d-none");
+    document.body.style.overflow = "hidden";
+    const startedAt = Date.now();
+    const updateTimer = function () {
+      const totalSeconds = Math.floor((Date.now() - startedAt) / 1000);
+      const hours = String(Math.floor(totalSeconds / 3600)).padStart(2, "0");
+      const minutes = String(Math.floor((totalSeconds % 3600) / 60)).padStart(2, "0");
+      const seconds = String(totalSeconds % 60).padStart(2, "0");
+      timer.textContent = hours + ":" + minutes + ":" + seconds;
+    };
+    updateTimer();
+    const timerInterval = window.setInterval(updateTimer, 1000);
+    window.requestAnimationFrame(function () {
+      window.setTimeout(function () {
+        if (window.self === window.top) {
+          HTMLFormElement.prototype.submit.call(form);
+          return;
+        }
+
+        const submitUrl = form.getAttribute("action") || window.location.href;
+        const submitMethod = form.getAttribute("method") || "POST";
+        fetch(submitUrl, {
+          method: submitMethod,
+          body: new FormData(form),
+          credentials: "same-origin",
+          redirect: "follow"
+        })
+          .then(function (response) {
+            window.clearInterval(timerInterval);
+            const responseUrl = response.url || submitUrl;
+            const submittedPath = new URL(submitUrl, window.location.href).pathname;
+            const responsePath = new URL(responseUrl, window.location.href).pathname;
+            if (isRestore && response.redirected && responsePath !== submittedPath) {
+              window.top.location.assign(responseUrl);
+              return;
+            }
+            window.location.assign(responseUrl);
+          })
+          .catch(function () {
+            window.clearInterval(timerInterval);
+            title.textContent = label + " connection interrupted";
+            message.textContent = "The server response could not be received. Check the backup list before trying this operation again.";
+            if (logoutWarning) {
+              logoutWarning.classList.add("d-none");
+            }
+          });
+      }, 50);
+    });
+  });
+});
+
+document.addEventListener("click", function (event) {
+  const button = event.target.closest(".js-backup-delete");
+  if (!button) return;
+  if (!confirm("Delete this backup file?")) return;
+  const csrf = "{{ csrf_token }}";
+  fetch(button.dataset.url, {
+    method: "POST",
+    credentials: "same-origin",
+    headers: {
+      "X-CSRFToken": csrf,
+      "X-Requested-With": "XMLHttpRequest"
+    }
+  })
+    .then(response => response.json())
+    .then(data => {
+      if (!data.success) {
+        alert(data.error || "Could not delete backup.");
+        return;
+      }
+      button.closest("tr")?.remove();
+    })
+    .catch(() => alert("Could not delete backup."));
+});
+</script>
+{% endblock %}
