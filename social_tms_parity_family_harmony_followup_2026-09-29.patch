+<script>
+function suggestionGetCookie(name) {
+  let cookieValue = null;
+  if (document.cookie && document.cookie !== '') {
+    const cookies = document.cookie.split(';');
+    for (let i = 0; i < cookies.length; i++) {
+      const cookie = cookies[i].trim();
+      if (cookie.substring(0, name.length + 1) === (name + '=')) {
+        cookieValue = decodeURIComponent(cookie.substring(name.length + 1));
+        break;
+      }
+    }
+  }
+  return cookieValue;
+}
+
+const TICKET_STATUS_CHOICES = JSON.parse(document.getElementById("ticket-status-choices").textContent);
+
+document.querySelectorAll('input[type="file"][name="photos"]').forEach(function (input) {
+  input.addEventListener("change", function () {
+    const preview = input.parentElement.querySelector("[data-photo-preview]");
+    if (!preview) return;
+    preview.replaceChildren();
+    Array.from(input.files || []).forEach(function (file) {
+      const figure = document.createElement("figure");
+      const img = document.createElement("img");
+      const caption = document.createElement("figcaption");
+      img.alt = file.name;
+      img.src = URL.createObjectURL(file);
+      img.onload = function () { URL.revokeObjectURL(img.src); };
+      caption.textContent = file.name;
+      figure.append(img, caption);
+      preview.appendChild(figure);
+    });
+  });
+});
+
+function formatTicketDate(raw) {
+  if (!raw) return "-";
+  const d = new Date(raw);
+  if (isNaN(d.getTime())) return raw;
+  const mm = String(d.getMonth() + 1).padStart(2, "0");
+  const dd = String(d.getDate()).padStart(2, "0");
+  const yyyy = d.getFullYear();
+  let hh = d.getHours();
+  const min = String(d.getMinutes()).padStart(2, "0");
+  const ampm = hh >= 12 ? "PM" : "AM";
+  hh = hh % 12;
+  if (hh === 0) hh = 12;
+  return mm + "-" + dd + "-" + yyyy + " " + hh + ":" + min + " " + ampm;
+}
+
+document.querySelectorAll(".js-ticket-date").forEach(function (el) {
+  el.textContent = formatTicketDate(el.dataset.created);
+});
+
+document.addEventListener("change", function (e) {
+  const filterEl = e.target.closest(".js-ticket-filter");
+  if (filterEl) {
+    const form = filterEl.closest("form");
+    if (form) form.submit();
+  }
+});
+
+document.addEventListener("click", function (e) {
+  const badge = e.target.closest(".ticket-status-badge");
+  if (badge) {
+    activateStatusEdit(badge);
+    return;
+  }
+
+  const button = e.target.closest(".js-ticket-delete");
+  if (button) {
+    if (!confirm("Delete this suggestion?")) return;
+    const csrftoken = suggestionGetCookie("csrftoken") || "{{ csrf_token }}";
+    const formData = new FormData();
+    formData.append("csrfmiddlewaretoken", csrftoken);
+    fetch(button.dataset.url, {
+      method: "POST",
+      body: formData,
+      credentials: "same-origin",
+      headers: { "X-Requested-With": "XMLHttpRequest", "X-CSRFToken": csrftoken },
+    })
+    .then(r => r.json())
+    .then(data => {
+      if (!data || !data.success) {
+        throw new Error((data && data.error) || "Could not delete suggestion.");
+      }
+      const ticketId = button.closest("[data-ticket-row]").dataset.ticketRow;
+      document.querySelectorAll('[data-ticket-row="' + ticketId + '"]')
+        .forEach(function (row) { row.remove(); });
+    })
+    .catch(err => alert(err && err.message ? err.message : "Delete failed."));
+  }
+});
+
+function activateStatusEdit(badge) {
+  if (badge.dataset.editing === "1") return;
+  badge.dataset.editing = "1";
+
+  const wrap = document.createElement("span");
+  wrap.className = "ticket-status-edit-wrap";
+
+  const select = document.createElement("select");
+  select.className = "form-select form-select-sm";
+  TICKET_STATUS_CHOICES.forEach(function (choice) {
+    const opt = document.createElement("option");
+    opt.value = choice[0];
+    opt.textContent = choice[1];
+    if (choice[0] === badge.dataset.status) opt.selected = true;
+    select.appendChild(opt);
+  });
+  wrap.appendChild(select);
+  badge.replaceWith(wrap);
+
+  const ticketId = badge.dataset.ticketId;
+  const url = badge.dataset.url;
+  const originalStatus = badge.dataset.status;
+  const originalLabel = badge.textContent;
+  const $select = $(select);
+  let handled = false;
+
+  function restoreBadge(newValue, newLabel) {
+    const newBadge = document.createElement("span");
+    newBadge.className = "badge bg-secondary ticket-status-badge";
+    newBadge.setAttribute("role", "button");
+    newBadge.setAttribute("tabindex", "0");
+    newBadge.dataset.ticketId = ticketId;
+    newBadge.dataset.status = newValue;
+    newBadge.dataset.url = url;
+    newBadge.textContent = newLabel;
+    wrap.replaceWith(newBadge);
+  }
+
+  $select.select2({ width: "150px", minimumResultsForSearch: -1, dropdownAutoWidth: false });
+  $select.select2("open");
+
+  $select.on("select2:select", function () {
+    handled = true;
+    const newValue = select.value;
+    const newLabel = select.options[select.selectedIndex].text;
+    if (newValue === originalStatus) {
+      restoreBadge(newValue, newLabel);
+      return;
+    }
+    const formData = new FormData();
+    formData.append("status", newValue);
+    const csrftoken = suggestionGetCookie("csrftoken");
+    formData.append("csrfmiddlewaretoken", csrftoken || "{{ csrf_token }}");
+
+    fetch(url, {
+      method: "POST",
+      body: formData,
+      credentials: "same-origin",
+      headers: {
+        "X-Requested-With": "XMLHttpRequest",
+        "X-CSRFToken": csrftoken || "{{ csrf_token }}"
+      },
+    })
+    .then(r => r.json())
+    .then(data => {
+      if (!data || !data.ok) throw new Error((data && data.error) || "Could not update status.");
+      restoreBadge(newValue, newLabel);
+    })
+    .catch(err => {
+      alert(err && err.message ? err.message : "Status update failed.");
+      restoreBadge(originalStatus, originalLabel);
+    });
+  });
+
+  $select.on("select2:close", function () {
+    setTimeout(function () {
+      if (!handled && wrap.isConnected) restoreBadge(originalStatus, originalLabel);
+    }, 150);
+  });
+}
+</script>
+<script>
+document.addEventListener("DOMContentLoaded", function () {
+  const form = document.querySelector("#newTicketModal form[enctype='multipart/form-data']");
+  const input = form ? form.querySelector("input[type='file'][name='photos']") : null;
+  const alertEl = document.getElementById("newTicketPhotoAlert");
+  if (!form || !input || !alertEl) return;
+
+  const MAX = 5 * 1024 * 1024;
+  const allowedExt = [".jpg", ".jpeg", ".png", ".webp", ".heic", ".heif"];
+
+  function showError(msg) {
+    alertEl.textContent = msg || "";
+    alertEl.classList.toggle("d-none", !msg);
+  }
+
+  function validateFiles(files) {
+    Array.from(files || []).forEach(function (file) {
+      const name = String(file.name || "").toLowerCase();
+      const ext = name.slice(name.lastIndexOf("."));
+      if (file.size > MAX) throw new Error((file.name || "Photo") + ": maximum allowed size is 5MB.");
+      if (ext && !allowedExt.includes(ext)) throw new Error((file.name || "Photo") + ": unsupported image type.");
+    });
+  }
+
+  input.addEventListener("change", function () {
+    try { validateFiles(input.files); showError(""); }
+    catch (e) { showError(e && e.message ? e.message : "Invalid photo."); }
+  });
+
+  form.addEventListener("submit", function (e) {
+    try { validateFiles(input.files); showError(""); }
+    catch (err) {
+      e.preventDefault();
+      showError(err && err.message ? err.message : "Invalid photo.");
+    }
+  });
+});
+</script>
+<script>
+document.addEventListener("DOMContentLoaded", function () {
+  const description = document.querySelector("#newTicketModal textarea[name='description']");
+  if (!description) return;
+
+  description.addEventListener("focus", function () {
+    if (!description.value.trim()) {
+      description.value = "1. ";
+      description.setSelectionRange(description.value.length, description.value.length);
+    }
+  });
+
+  description.addEventListener("keydown", function (event) {
+    if (event.key !== "Enter" || event.shiftKey) return;
+    const cursor = description.selectionStart;
+    const lineStart = description.value.lastIndexOf("\n", cursor - 1) + 1;
+    const currentLine = description.value.slice(lineStart, cursor);
+    const match = currentLine.match(/^(\s*)(\d+)[.)]\s+(.*)$/);
+    if (!match) return;
+
+    event.preventDefault();
+    if (!match[3].trim()) {
+      description.setRangeText("", lineStart, cursor, "end");
+      return;
+    }
+    description.setRangeText("\n" + match[1] + (Number(match[2]) + 1) + ". ", cursor, cursor, "end");
+  });
+});
+</script>
+{% endblock %}
