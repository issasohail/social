+{% extends "base.html" %}
+{% block title %}Backup & Restore{% endblock %}
+{% block content %}
+<div class="backup-center container-fluid py-3 px-0">
+  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
+    <div>
+      <h3 class="mb-0">Backup &amp; Restore</h3>
+      <div class="text-muted small">
+        Superuser only. Backup, restore, and reset actions are protected and use POST-only actions.
+      </div>
+    </div>
+    <div class="backup-actions d-flex flex-wrap gap-2">
