+                    </td>
+                    <td data-label="Size">{% if b.file_exists %}{{ b.human_size }}{% else %}—{% endif %}</td>
+                    <td data-label="Created" class="backup-cell-created">{{ b.created_at|date:"Y-m-d H:i:s" }}</td>
+                    <td data-label="Storage" class="backup-cell-storage">{{ b.get_storage_mode_display }}</td>
+                    <td data-label="Actions" class="backup-cell-actions">
+                      <div class="backup-row-actions">
