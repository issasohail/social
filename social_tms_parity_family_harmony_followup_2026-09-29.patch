+            <span><strong>Available:</strong> {{ backup_storage.disk_free|filesizeformat }}</span>
+            <span><strong>Total:</strong> {{ backup_storage.disk_total|filesizeformat }}</span>
+            <form method="post" class="ms-lg-auto js-long-operation" data-operation-label="Backup purge" data-confirm-message="Delete every old backup except the newest 3 files of each type? This cannot be undone.">
