+<script>(function(){function csrf(){return document.cookie.split('; ').find(x=>x.startsWith('csrftoken='))?.split('=')[1]||''}document.querySelectorAll('.setting-card').forEach(card=>{const url=card.dataset.url,state=card.querySelector('.setting-save-state');async function send(action,index,value){let fd=new FormData();fd.append('action',action);if(index!==null)fd.append('index',index);if(value!==null)fd.append('value',value);state.textContent='Saving…';let r=await fetch(url,{method:'POST',headers:{'X-CSRFToken':csrf()},body:fd});let j=await r.json();if(!r.ok||!j.ok){state.textContent=j.error||'Save failed';return false}state.textContent='Saved';setTimeout(()=>state.textContent='',1000);return true}card.querySelectorAll('.setting-value').forEach(inp=>inp.addEventListener('change',async()=>{await send('update',inp.dataset.index,inp.value)}));card.querySelectorAll('.setting-delete').forEach(btn=>btn.addEventListener('click',async()=>{if(confirm('Delete this option?')&&await send('delete',btn.dataset.index,''))location.reload()}));let add=card.querySelector('.setting-add-btn'),input=card.querySelector('.setting-new');add.addEventListener('click',async()=>{if(input.value.trim()&&await send('add',null,input.value.trim()))location.reload()})})})();</script>
