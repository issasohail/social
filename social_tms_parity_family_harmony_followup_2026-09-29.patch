+                    <td data-label="Name" class="backup-cell-name">
+                      <div class="fw-semibold">{{ b.name }}</div>
+                    </td>
+                    <td data-label="Type" class="backup-cell-type">{{ b.get_backup_type_display }}</td>
+                    <td data-label="Status" class="backup-cell-status">
