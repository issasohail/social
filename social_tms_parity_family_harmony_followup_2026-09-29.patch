+        <input type="hidden" name="action" value="backup_db">
+        <button type="submit" class="btn btn-sm btn-outline-primary">
+          <i class="bi bi-database me-1"></i> Backup DB
+        </button>
+      </form>
+      <form method="post" class="d-inline js-long-operation" data-operation-label="Media backup">
+        {% csrf_token %}
+        <input type="hidden" name="action" value="backup_media">
+        <button type="submit" class="btn btn-sm btn-outline-primary">
+          <i class="bi bi-images me-1"></i> Backup Media
+        </button>
+      </form>
+      <form method="post" class="d-inline js-long-operation" data-operation-label="Full backup">
+        {% csrf_token %}
+        <input type="hidden" name="action" value="backup_full">
+        <button type="submit" class="btn btn-sm btn-danger">
+          <i class="bi bi-shield-check me-1"></i> Full Backup
+        </button>
+      </form>
+      <form method="post" class="d-inline">
+        {% csrf_token %}
+        <input type="hidden" name="action" value="fresh_reset">
+        <input type="hidden" name="confirm_text" value="RESET SOCIAL">
+        <button type="submit" class="btn btn-sm btn-outline-danger">Run Fresh Reset</button>
+      </form>
+    </div>
+  </div>
+
+  <div class="alert alert-warning py-2 small">
+    <strong>Important:</strong>
+    Restore operations are destructive. The system now creates a safety backup immediately before restore actions.
+    Live source code restore should remain disabled in production unless you intentionally enable it.
+  </div>
+
+  <div class="row g-3">
+    <div class="col-12">
+      <div class="card shadow-sm">
+        <div class="card-header py-2"><strong>Backup Settings, Upload &amp; Smart Restore</strong></div>
+        <div class="card-body backup-control-grid">
+          <form method="post" id="backupSettingsForm" class="backup-settings-form">
+            {% csrf_token %}<input type="hidden" name="action" value="save_backup_settings">
