+{% extends 'base.html' %}
+{% block title %}User access | Social Welfare{% endblock %}
+{% block content %}
+<section class="page-head inline compact-head">
+  <div><p class="eyebrow">ADMINISTRATION</p><h1>User access</h1><p class="muted">Council admins delegate across boards below them. Board admins delegate only within their board.</p></div>
+  <a class="primary" href="{% url 'staff_user_create' %}">+ Create user</a>
+</section>
+<section class="panel form-panel user-access-filters">
+  <form method="get" class="access-filter-grid">
+    <input type="search" name="q" value="{{ filters.q }}" placeholder="Search name, username, email or phone">
+    <select name="level" data-searchable="true"><option value="">All levels</option>{% for value,label in levels %}<option value="{{ value }}" {% if filters.level == value %}selected{% endif %}>{{ label }}</option>{% endfor %}</select>
+    <select name="role" data-searchable="true"><option value="">All roles</option>{% for value,label in roles %}<option value="{{ value }}" {% if filters.role == value %}selected{% endif %}>{{ label }}</option>{% endfor %}</select>
+    <select name="board" data-searchable="true"><option value="">All boards</option>{% for board in boards %}<option value="{{ board.id }}" {% if filters.board == board.id|stringformat:'s' %}selected{% endif %}>{{ board.short_name|default:board.name }}</option>{% endfor %}</select>
+    <select name="regional_council" data-searchable="true"><option value="">All RCs</option>{% for c in regional_councils %}<option value="{{ c.id }}" {% if filters.regional_council == c.id|stringformat:'s' %}selected{% endif %}>{{ c.name }}</option>{% endfor %}</select>
+    <select name="local_council" data-searchable="true"><option value="">All LCs</option>{% for c in local_councils %}<option value="{{ c.id }}" {% if filters.local_council == c.id|stringformat:'s' %}selected{% endif %}>{{ c.name }}</option>{% endfor %}</select>
+    <select name="jamatkhana" data-searchable="true"><option value="">All Jamatkhanas</option>{% for c in jamatkhanas %}<option value="{{ c.id }}" {% if filters.jamatkhana == c.id|stringformat:'s' %}selected{% endif %}>{{ c }}</option>{% endfor %}</select>
+    <button class="primary">Filter</button><a class="secondary" href="{% url 'staff_users' %}">Clear</a>
+  </form>
+</section>
+
+<section class="panel table-wrap user-access-table-wrap">
+  <table class="data-table user-access-table">
+    <thead><tr><th>#</th><th>Person / Account</th><th>Home Jamatkhana</th><th>Access assignments</th><th>Status</th><th>Actions</th></tr></thead>
+    <tbody>
+      {% for user in users %}
+      <tr>
+        <td>{{ forloop.counter }}</td>
+        <td>
+          <strong>{% if user.person_record %}{{ user.person_record.full_name }}{% else %}{{ user.get_full_name|default:user.username }}{% endif %}</strong>
+          <small>{{ user.username }}{% if user.email %} · {{ user.email }}{% endif %}{% if user.phone_number %} · {{ user.phone_number }}{% endif %}</small>
+        </td>
+        <td>{% if user.person_record and user.person_record.jamatkhana %}{{ user.person_record.jamatkhana }}{% else %}<span class="muted">—</span>{% endif %}</td>
+        <td>
+          <div class="access-stack">
+          {% for access in user.jurisdiction_access.all %}
+            <div class="access-pill {% if not access.is_active %}is-inactive{% endif %}">
+              <strong>{{ access.get_level_display }} · {{ access.jurisdiction_label }}</strong>
+              <span>{% if access.board %}{{ access.board.short_name|default:access.board.name }}{% else %}All boards / Council{% endif %} · {{ access.get_role_display }}</span>
+              {% if access.capabilities %}<small>{{ access.capabilities|join:', ' }}</small>{% endif %}
+              {% if access.is_active %}
+              <form method="post" action="{% url 'staff_access_delete' access.id %}" onsubmit="return confirm('Remove this access assignment?');">{% csrf_token %}<button type="submit" class="link-danger">Remove</button></form>
+              {% endif %}
+            </div>
+          {% empty %}<span class="muted">No access</span>{% endfor %}
+          </div>
+        </td>
+        <td>{% if user.is_active %}<span class="status-pill">Active</span>{% else %}<span class="status-pill inactive">Inactive</span>{% endif %}</td>
+        <td><a class="secondary mini-action" href="{% url 'staff_access_create' user.id %}">+ Access</a></td>
+      </tr>
+      {% empty %}<tr><td colspan="6" class="muted">No users found in your management scope.</td></tr>{% endfor %}
+    </tbody>
+  </table>
+</section>
+{% endblock %}
